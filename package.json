{
  "name": "shelfnu-bot",
  "version": "1.0.0",
  "description": "DCSO Internal Automation - Telegram Bot for iAssets",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.27.0",
    "@grammyjs/conversations": "^1.2.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8",
    "qs": "^6.12.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.8",
    "@types/qs": "^6.9.15",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
