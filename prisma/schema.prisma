generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  SUBMITTED
  FAILED
  CANCELLED
}

model AssetRequest {
  id             String        @id @default(cuid())
  telegramUserId String
  telegramUsername String?
  assetName      String
  categoryId     String
  quantity       Int
  urgency        Urgency
  justification  String
  status         RequestStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([telegramUserId])
  @@index([status])
  @@map("asset_requests")
}

model Settings {
  id             String   @id @default(cuid())
  organizationId String
  cookieSession  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

enum TabunganType {
  EARNED
  USED
}

enum TabunganStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberRole {
  MEMBER
  SUPERVISOR
}

model Member {
  id               String   @id @default(cuid())
  telegramUserId   String   @unique
  telegramUsername String?
  fullName         String
  role             MemberRole @default(MEMBER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tabunganEntries  TabunganLibur[] @relation("MemberTabungan")
  approvals        TabunganLibur[] @relation("SupervisorApproval")
  leaveRequests    LeaveRequest[]  @relation("MemberLeave")
  leaveApprovals   LeaveRequest[]  @relation("SupervisorLeave")
  shiftSchedules   ShiftSchedule[]
  leaveQuotas      LeaveQuota[]

  @@map("members")
}

model TabunganLibur {
  id               String         @id @default(cuid())
  memberId         String
  member           Member         @relation("MemberTabungan", fields: [memberId], references: [id])
  type             TabunganType
  holidayDate      DateTime
  holidayName      String
  notes            String?
  status           TabunganStatus @default(PENDING)
  approvedById     String?
  approvedBy       Member?        @relation("SupervisorApproval", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([holidayDate])
  @@map("tabungan_libur")
}

model PublicHoliday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  type      String
  createdAt DateTime @default(now())

  @@map("public_holidays")
}

enum LeaveType {
  ANNUAL
  SICK
  PERMISSION
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ShiftType {
  PAGI
  SIANG
  MALAM
  OFF
}

model LeaveQuota {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  year     Int
  total    Int    @default(12)

  @@unique([memberId, year])
  @@map("leave_quotas")
}

model LeaveRequest {
  id              String      @id @default(cuid())
  memberId        String
  member          Member      @relation("MemberLeave", fields: [memberId], references: [id])
  type            LeaveType
  startDate       DateTime
  endDate         DateTime
  days            Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  approvedBy      Member?     @relation("SupervisorLeave", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([memberId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

model ShiftSchedule {
  id        String    @id @default(cuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id])
  date      DateTime
  shift     ShiftType
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([memberId, date])
  @@index([memberId])
  @@index([date])
  @@map("shift_schedules")
}
